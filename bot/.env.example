# Zugangsdaten für den Telegram-Assistenten.
# Kopieren als .env — diese Datei gehört NICHT ins Repository und steht
# deshalb in .gitignore. Niemals Token oder Schlüssel in den Code schreiben.

# Von @BotFather in Telegram: /newbot, Namen vergeben, Token kopieren.
TELEGRAM_TOKEN=

# Die eigene Chat-Kennung. Leer lassen, den Bot starten, ihm schreiben —
# er nennt die Kennung, dann hier eintragen und neu starten.
# Nur dieser Chat wird bedient; alle anderen bekommen eine Absage.
TELEGRAM_CHAT_ID=

# --- Die Gruppen ---------------------------------------------------------
# Der Signal-Bot verteilt deine Signale an zwei Stufen:
#   VIP           bezahlt, nur auf deine Einladung. Bekommt jedes Signal
#                 sofort, mit Begründung und CRV.
#   Inner Circle  offen für alle. Bekommt höchstens zwei Signale am Tag,
#                 mit Verzug, knapp, und darunter den Hinweis auf VIP.
#
# So kommst du an die Kennungen:
#   1. Gruppe in Telegram anlegen.
#   2. Deinen Bot als Mitglied hinzufügen und zum Administrator machen.
#      Das Recht "Nutzer einladen" muss an sein, sonst gibt es keine
#      Einladungslinks.
#   3. Irgendetwas in die Gruppe schreiben.
#   4. In der Gruppe /gruppen an den Bot schicken — oder den Bot kurz
#      starten; die Kennung steht in seiner Ausgabe. Sie beginnt mit -100.
TELEGRAM_INNER_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=

# Wie viele Minuten Vorsprung VIP hat, bevor ein Signal auch in den
# Inner Circle geht. 0 heißt gleichzeitig, höchstens 240.
TELEGRAM_INNER_VERZUG=20

# Wie viele Gratis-Signale der Inner Circle am Tag bekommt. 0 schaltet
# ihn ab, dann geht alles nur an VIP. Höchstens 20.
TELEGRAM_INNER_PRO_TAG=2

# --- Wer antwortet -------------------------------------------------------
# Einer von beiden reicht. Sind beide da, gewinnt Claude; mit BENGX_ANBIETER
# lässt sich das erzwingen (gemini oder claude).

# Gemini von Google — hat ein kostenloses Kontingent.
# Schlüssel unter aistudio.google.com, ohne Kreditkarte.
# Beim kostenlosen Kontingent behält Google sich vor, die Inhalte zur
# Verbesserung seiner Dienste auszuwerten.
#   pip install google-genai
GOOGLE_API_KEY=

# Claude von Anthropic — kostet Geld, antwortet gründlicher und kann als
# einziger den Coding-Agenten antreiben. Schlüssel unter platform.claude.com;
# das ist NICHT das Claude-Abo, sondern getrennt abgerechnet.
#   pip install anthropic
ANTHROPIC_API_KEY=

# BENGX_ANBIETER=gemini
# BENGX_GEMINI_MODEL=      # leer: der Schlüssel wird gefragt,
#                          # genommen wird das kleinste Modell

# --- Am Code weiterbauen -------------------------------------------------
# Schreibt Ben "baue an der Website weiter", startet auf DIESER Maschine ein
# Coding-Agent, der Dateien ändert, testet und committet. Er schiebt nichts
# nach außen. Standardmäßig AUS — bewusst einschalten.
#   pip install claude-agent-sdk
# BENGX_CODER=1
# BENGX_REPO=..                 # das Repository, relativ zu bot/
# BENGX_CODER_TURNS=40          # höchstens so viele Schritte
# BENGX_CODER_BUDGET=2.0        # höchstens so viele Dollar je Auftrag
# BENGX_CODER_TIMEOUT=900       # Abbruch nach so vielen Sekunden

# Optional
# BENGX_MODEL=claude-opus-5-5     # nur für Claude
# BENGX_EFFORT=low          # low | medium | high — low ist schnell und günstig
# BENGX_MAX_TOKENS=1200
# TELEGRAM_POLL_TIMEOUT=50
# BENGX_WEBSUCHE=1         # Websuche an. Läuft bei Anthropic mit,
#                          # ein eigener Suchschlüssel ist nicht nötig.
