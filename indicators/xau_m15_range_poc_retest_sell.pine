//@version=6
// ============================================================================
//  XAUUSD M15 – Akkumulationszone · POC · Breakout & Retest (SELL)
//
//  Logik:
//   1. Zonen-Start: N Kerzen (Standard 6), die sich nicht mehr als X Pips
//      bewegen (Standard 100 Pips).
//   2. Die Zone wächst mit, solange die Gesamthöhe max. Y Pips bleibt
//      (Standard 300 Pips = 30 USD, wie die markierten Beispielzonen).
//      Dochte, die darüber hinausgehen, werden ignoriert.
//   3. Solange die Zone aktiv ist, wird ihr POC (Volumenprofil) als EINE rote
//      Linie gezeichnet, die durchgehend nach rechts verlängert wird.
//   4. Breakout = Schluss mind. 100 Pips außerhalb der Zone. Ab dann wird
//      KEIN POC mehr angezeigt (Zone verbraucht).
//   5. War der Breakout nach unten, merkt sich der Indikator den POC und wartet
//      auf den Retest: Hoch berührt den POC, Schluss darunter -> SELL.
//
//  Zonen (Boxen) und Signale von heute + den letzten X Handelstagen bleiben sichtbar.
//  Pip-Größe Gold: meist 1 Pip = 0.10 USD (100 Pips = 10 USD).
// ============================================================================
indicator("XAU M15 – Zone POC Breakout & Retest (Sell)", shorttitle="XAU Zone POC Sell", overlay=true, max_bars_back=500, max_lines_count=50, max_labels_count=500, max_boxes_count=500)

// ─── Inputs ─────────────────────────────────────────────────────────────────
grpZ = "1) Akkumulationszone"
pipSize     = input.float(0.10, "Pip-Größe", minval=0.0001, group=grpZ, tooltip="Gold (XAUUSD): meist 0.10 = 1 Pip. Falls dein Broker 0.01 als Pip zählt, hier ändern.")
seedBars    = input.int(6, "Start: Anzahl Kerzen", minval=2, maxval=50, group=grpZ, tooltip="So viele Kerzen müssen eng beieinander liegen, damit eine Zone startet (5–6).")
seedPips    = input.float(100, "Start: max. Bewegung (Pips)", minval=1, group=grpZ, tooltip="Max. Hoch-Tief dieser Start-Kerzen (80–100 Pips).")
maxZonePips = input.float(300, "Max. Höhe der Zone (Pips)", minval=1, group=grpZ, tooltip="Bis zu dieser Höhe wächst die Zone mit. Deine markierten Beispielzonen waren ca. 130–280 Pips hoch.")
minZoneBars = input.int(10, "Min. Länge einer Zone (Kerzen)", minval=2, maxval=200, group=grpZ, tooltip="Kürzere Zonen werden beim Breakout verworfen. Deine Beispielzonen waren ca. 15–40 Kerzen lang.")
maxZoneBars = input.int(300, "Max. Länge einer Zone (Kerzen)", minval=10, maxval=400, group=grpZ)

grpP = "2) POC"
vpRows     = input.int(40, "Volumenprofil: Preisstufen", minval=5, maxval=200, group=grpP)
pocColor   = input.color(color.red, "POC Farbe", group=grpP)
pocWidth   = input.int(2, "POC Linienbreite", minval=1, maxval=5, group=grpP)
showPocLbl = input.bool(true, "POC-Preis anzeigen", group=grpP)
keepPoc    = input.bool(false, "POC nach Breakout bis zum Retest weiter zeigen", group=grpP, tooltip="Aus = POC verschwindet, sobald die Zone durchbrochen ist (der Retest wird intern trotzdem überwacht).")

grpB = "3) Breakout"
breakoutPips = input.float(100, "Min. Breakout (Pips)", minval=1, group=grpB, tooltip="Abstand zur Zonen-Grenze, ab dem die Zone als durchbrochen gilt.")
breakoutSrc  = input.string("Schlusskurs", "Breakout bestätigt durch", options=["Schlusskurs", "Docht"], group=grpB)

grpT = "4) Retest & Signal"
retestRef        = input.string("POC", "Retest-Level", options=["POC", "Zonen-Tief"], group=grpT)
retestTolPips    = input.float(10, "Retest-Toleranz (Pips)", minval=0, group=grpT, tooltip="Hoch muss bis auf diese Distanz an das Level herankommen.")
requireRejection = input.bool(true, "Schluss unter Level erforderlich", group=grpT)
invalidPips      = input.float(20, "Setup ungültig bei Schluss über Level + (Pips)", minval=0, group=grpT)
maxBarsRetest    = input.int(60, "Max. Kerzen bis Retest", minval=1, group=grpT)

grpD = "5) Anzeige"
zoneDays   = input.int(2, "Zonen der letzten X Tage zeigen", minval=0, maxval=10, group=grpD, tooltip="Heute + die letzten X Handelstage. Ältere Zonen werden gelöscht.")
zoneColor  = input.color(color.blue, "Zonen-Farbe", group=grpD)
showStatus = input.bool(true, "Status-Tabelle anzeigen", group=grpD)

// ─── Volumenprofil -> POC ────────────────────────────────────────────────────
// Verteilt das Volumen jeder Kerze (Offsets fromOff..toOff) anteilig auf die
// Preisstufen zwischen lo und hi und liefert die Mitte der stärksten Stufe.
f_poc(int fromOff, int toOff, float lo, float hi, int rows) =>
    float step = (hi - lo) / rows
    float result = (hi + lo) / 2
    if step > 0 and toOff >= fromOff
        array<float> vols = array.new<float>(rows, 0.0)
        for i = fromOff to toOff
            float h = math.min(high[i], hi)
            float l = math.max(low[i], lo)
            float rawV = nz(volume[i])
            float v = rawV > 0 ? rawV : 1.0   // kein Volumen verfügbar -> Zeit am Preis
            if h >= l
                int r1 = math.max(0, math.min(rows - 1, math.floor((l - lo) / step)))
                int r2 = math.max(0, math.min(rows - 1, math.floor((h - lo) / step)))
                if h - l <= 0
                    array.set(vols, r1, array.get(vols, r1) + v)
                else
                    for r = r1 to r2
                        float rowLo = lo + r * step
                        float rowHi = rowLo + step
                        float ov = math.max(0.0, math.min(h, rowHi) - math.max(l, rowLo))
                        array.set(vols, r, array.get(vols, r) + v * ov / (h - l))
        int pocIdx = array.indexof(vols, array.max(vols))
        result := lo + (pocIdx + 0.5) * step
    result

// ─── Aufräumen alter Zonen ──────────────────────────────────────────────────
f_cleanBoxes(array<box> objs, array<int> ts, int cutoff, int keep) =>
    while array.size(ts) > keep
        if array.get(ts, 0) >= cutoff
            break
        box.delete(array.shift(objs))
        array.shift(ts)
    true

f_cleanLabels(array<label> objs, array<int> ts, int cutoff) =>
    while array.size(ts) > 0
        if array.get(ts, 0) >= cutoff
            break
        label.delete(array.shift(objs))
        array.shift(ts)
    true

// ─── Zustände ───────────────────────────────────────────────────────────────
// Zone:  zState 0 = suche Zone | 1 = Zone aktiv
// Setup: sState 0 = kein Setup | 1 = Breakout nach unten, warte auf Retest
var int   zState    = 0
var int   zStart    = na
var int   zStartT   = na
var int   zEnd      = na
var float zHi       = na
var float zLo       = na
var box   zBox      = na

var int   sState    = 0
var int   sBar      = na
var int   sX        = na
var float sPoc      = na
var float sLo       = na

var line  pocLine   = na
var label pocLbl    = na

var array<box>   zBoxes    = array.new<box>()
var array<int>   zBoxT     = array.new<int>()
var array<label> zLbls     = array.new<label>()
var array<int>   zLblT     = array.new<int>()
var array<int>   dayStarts = array.new<int>()

float pip     = pipSize
float hh      = ta.highest(high, seedBars)
float ll      = ta.lowest(low, seedBars)
bool  sellSignal  = false
bool  breakoutNow = false

// ─── A) Offenes Sell-Setup: auf Retest warten ───────────────────────────────
if sState == 1 and bar_index > sBar
    float lvl = retestRef == "POC" ? sPoc : sLo
    if close > lvl + invalidPips * pip
        sState := 0                                    // zurück über das Level -> ungültig
    else if high >= lvl - retestTolPips * pip and (not requireRejection or close < lvl)
        sellSignal := true
        sState := 0
        array.push(zLbls, label.new(bar_index, high, "SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small))
        array.push(zLblT, time)
    else if bar_index - sBar >= maxBarsRetest
        sState := 0

// ─── B) Aktive Zone: wachsen lassen oder Breakout ───────────────────────────
if zState == 1
    float dnPx  = breakoutSrc == "Schlusskurs" ? close : low
    float upPx  = breakoutSrc == "Schlusskurs" ? close : high
    bool  brkDn = dnPx <= zLo - breakoutPips * pip
    bool  brkUp = upPx >= zHi + breakoutPips * pip
    int   zLen  = bar_index - zStart                   // Kerzen der Zone vor dieser Kerze
    if brkDn or brkUp
        zEnd   := bar_index - 1
        zState := 0
        if zLen < minZoneBars
            // zu kurz -> keine echte Zone
            box.delete(array.pop(zBoxes))
            array.pop(zBoxT)
        else
            box.set_right(zBox, zEnd)
            if brkDn
                sPoc   := f_poc(1, zLen, zLo, zHi, vpRows)
                sLo    := zLo
                sX     := zStart
                sBar   := bar_index
                sState := 1
                breakoutNow := true
                array.push(zLbls, label.new(bar_index, low, "BO", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.red, 40), textcolor=color.white, size=size.tiny))
                array.push(zLblT, time)
    else if zLen + 1 > maxZoneBars
        zEnd   := bar_index - 1
        zState := 0
    else
        float nHi = math.max(zHi, high)
        float nLo = math.min(zLo, low)
        if nHi - nLo <= maxZonePips * pip
            zHi := nHi
            zLo := nLo
            box.set_top(zBox, zHi)
            box.set_bottom(zBox, zLo)
        box.set_right(zBox, bar_index)                 // Dochte über max. Höhe werden ignoriert

// ─── C) Neue Zone suchen ────────────────────────────────────────────────────
if zState == 0 and bar_index >= seedBars and hh - ll <= seedPips * pip
    int newStart = bar_index - seedBars + 1
    if na(zEnd) or newStart > zEnd
        zStart  := newStart
        zStartT := time[seedBars - 1]
        zHi     := hh
        zLo     := ll
        zState  := 1
        zBox    := box.new(zStart, zHi, bar_index, zLo, border_color=zoneColor, border_width=2, bgcolor=color.new(zoneColor, 88))
        array.push(zBoxes, zBox)
        array.push(zBoxT, zStartT)

// ─── D) Nur heute + die letzten X Handelstage anzeigen ──────────────────────
if timeframe.change("D")
    array.push(dayStarts, time)
    if array.size(dayStarts) > zoneDays + 1
        array.shift(dayStarts)

if array.size(dayStarts) == zoneDays + 1
    int cutoff = array.get(dayStarts, 0)
    f_cleanBoxes(zBoxes, zBoxT, cutoff, zState == 1 ? 1 : 0)
    f_cleanLabels(zLbls, zLblT, cutoff)

// ─── E) EINE rote POC-Linie, durchgehend nach rechts ────────────────────────
float curPoc = na
if barstate.islast
    int   x1 = na
    float y  = na
    if zState == 1
        curPoc := f_poc(0, bar_index - zStart, zLo, zHi, vpRows)
        x1 := zStart
        y  := curPoc
    else if keepPoc and sState == 1
        x1 := sX
        y  := sPoc
    line.delete(pocLine)
    label.delete(pocLbl)
    if not na(y)
        pocLine := line.new(x1, y, bar_index, y, extend=extend.right, color=pocColor, width=pocWidth)
        if showPocLbl
            pocLbl := label.new(bar_index + 3, y, "POC " + str.tostring(y, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=pocColor, size=size.small)

// ─── Alerts ─────────────────────────────────────────────────────────────────
alertcondition(sellSignal, "XAU POC Retest SELL", "Gold M15: Retest des POC nach Breakout – SELL-Signal")
alertcondition(breakoutNow, "XAU Zonen-Breakout", "Gold M15: Breakout nach unten aus der Akkumulationszone – warte auf Retest")

if sellSignal
    alert("SELL XAUUSD @ " + str.tostring(close, format.mintick) + " | POC " + str.tostring(sPoc, format.mintick), alert.freq_once_per_bar_close)

// ─── Status-Tabelle ─────────────────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 30), border_width=1)
if barstate.islast
    if showStatus
        string zTxt = zState == 1 ? "aktiv seit " + str.tostring(bar_index - zStart + 1) + " Kerzen" : "suche Seitwärtsphase"
        string rTxt = zState == 1 ? str.tostring(zLo, format.mintick) + " – " + str.tostring(zHi, format.mintick) : "–"
        string pTxt = zState == 1 ? str.tostring(curPoc, format.mintick) : "–"
        string sTxt = sState == 1 ? "warte auf Retest @ " + str.tostring(retestRef == "POC" ? sPoc : sLo, format.mintick) : "–"
        table.cell(info, 0, 0, "Zone", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, zTxt, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 1, "Tief – Hoch", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 1, rTxt, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "POC", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 2, pTxt, text_color=pocColor, text_size=size.small)
        table.cell(info, 0, 3, "Sell-Setup", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 3, sTxt, text_color=color.white, text_size=size.small)
    if timeframe.period != "15"
        table.cell(info, 0, 4, "Achtung", text_color=color.white, bgcolor=color.red, text_size=size.small)
        table.cell(info, 1, 4, "Für den 15-Min-Chart gebaut", text_color=color.white, bgcolor=color.red, text_size=size.small)
