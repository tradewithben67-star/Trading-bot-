# Zugangsdaten für den Telegram-Assistenten.
# Kopieren als .env — diese Datei gehört NICHT ins Repository und steht
# deshalb in .gitignore. Niemals Token oder Schlüssel in den Code schreiben.

# Von @BotFather in Telegram: /newbot, Namen vergeben, Token kopieren.
TELEGRAM_TOKEN=

# Die eigene Chat-Kennung. Leer lassen, den Bot starten, ihm schreiben —
# er nennt die Kennung, dann hier eintragen und neu starten.
# Nur dieser Chat wird bedient; alle anderen bekommen eine Absage.
TELEGRAM_CHAT_ID=

# --- Die Gruppen ---------------------------------------------------------
# Der Signal-Bot verteilt deine Signale an zwei Stufen:
#   VIP           bezahlt, nur auf deine Einladung. Bekommt jedes Signal
#                 sofort, mit Begründung und CRV.
#   Inner Circle  offen für alle. Bekommt genau zwei Signale am Tag: eins
#                 in der London-Sitzung, eins in der New-York-Sitzung.
#                 Zur selben Zeit wie VIP, aber knapp und ohne Begründung,
#                 mit dem Hinweis auf VIP darunter.
#
# So kommst du an die Kennungen:
#   1. Gruppe in Telegram anlegen.
#   2. Deinen Bot als Mitglied hinzufügen und zum Administrator machen.
#      Das Recht "Nutzer einladen" muss an sein, sonst gibt es keine
#      Einladungslinks.
#   3. Irgendetwas in die Gruppe schreiben.
#   4. In der Gruppe /gruppen an den Bot schicken — oder den Bot kurz
#      starten; die Kennung steht in seiner Ausgabe. Sie beginnt mit -100.
TELEGRAM_INNER_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=

# Minuten Vorsprung für VIP, bevor dasselbe Signal in den Inner Circle
# geht. 0 heißt gleichzeitig — so ist es gedacht, denn die zwei
# Gratis-Signale sollen mithandelbar sein. Mit Vorsprung wäre der
# Einstieg weg, bevor sie ihn sehen. Höchstens 240.
TELEGRAM_INNER_VERZUG=0

# Die beiden Sitzungsfenster, in deutscher Zeit. Je Fenster geht genau
# ein Gratis-Signal in den Inner Circle. London endet dort, wo New York
# beginnt — so fällt jedes Signal in höchstens ein Fenster. Signale
# ausserhalb (nachts, Asien) gehen nur an VIP.
TELEGRAM_FREI_LONDON=09:00-15:30
TELEGRAM_FREI_NEWYORK=15:30-23:00

# Wann der Tagesrückblick in beide Gruppen geht, in deutscher Zeit.
# Leer schaltet ihn ab. Läuft der Rechner um diese Zeit nicht, fällt der
# Rückblick für den Tag aus — nachgeholt wird er nicht.
TELEGRAM_RUECKBLICK=23:15

# Optional
# TELEGRAM_POLL_TIMEOUT=50
#                          # ein eigener Suchschlüssel ist nicht nötig.

# --- MetaTrader 5 ---------------------------------------------------------
# Nur nötig, wenn der Bot wirklich an ein Konto soll (live.broker = "mt5").
# Für Backtest und Papierkonto wird nichts davon gebraucht.
#
# Das Konto liegt bei Tradequo, das über MetaTrader 5 läuft. Das Paket
# MetaTrader5 gibt es nur für Windows:  pip install MetaTrader5
# Der Terminal muss laufen und angemeldet sein, und unter
# Extras → Optionen → Expert Advisors muss der Algo-Handel erlaubt sein.
#
# FANG MIT EINEM DEMOKONTO AN. Der Bot handelt dort ohne Backtest; an einem
# Echtgeldkonto verlangt er einen, und das lässt sich nicht abschalten.
#
# Kontonummer (eine Zahl). Steht im Terminal oben links über dem Konto.
MT5_LOGIN=

# Das Handelspasswort — nicht das Investorpasswort (das darf nicht handeln).
MT5_PASSWORD=

# Der Servername, genau wie im Terminal geschrieben, z. B. Tradequo-Demo.
MT5_SERVER=

# Nur falls der Terminal nicht am üblichen Ort liegt, z. B.
# C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
