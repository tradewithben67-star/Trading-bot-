# Zugangsdaten für den Telegram-Assistenten.
# Kopieren als .env — diese Datei gehört NICHT ins Repository und steht
# deshalb in .gitignore. Niemals Token oder Schlüssel in den Code schreiben.

# Von @BotFather in Telegram: /newbot, Namen vergeben, Token kopieren.
TELEGRAM_TOKEN=

# Die eigene Chat-Kennung. Leer lassen, den Bot starten, ihm schreiben —
# er nennt die Kennung, dann hier eintragen und neu starten.
# Nur dieser Chat wird bedient; alle anderen bekommen eine Absage.
TELEGRAM_CHAT_ID=

# Nur für freies Schreiben. Ohne Schlüssel laufen die Befehle trotzdem.
# Schlüssel unter platform.claude.com anlegen.
ANTHROPIC_API_KEY=

# Optional
# BENGX_MODEL=claude-opus-5-5
# BENGX_EFFORT=low          # low | medium | high — low ist schnell und günstig
# BENGX_MAX_TOKENS=1200
# TELEGRAM_POLL_TIMEOUT=50
