//@version=6
// ============================================================================
//  XAUUSD M15 – Range-POC Breakout & Retest (SELL)
//
//  Logik:
//   1. Seitwärtsphase finden: mind. N Kerzen (Standard 5), deren Gesamt-Range
//      (Hoch bis Tief) nicht größer als X Pips ist (Standard 100 Pips).
//      Die Range wird verlängert, solange neue Kerzen innerhalb dieses Limits bleiben.
//   2. Sobald die Range endet: Volumenprofil über alle Range-Kerzen berechnen
//      und NUR den POC (Point of Control) als Linie einzeichnen.
//   3. Auf einen Breakout nach unten warten (mind. 100 Pips unter Range-Tief bzw. POC).
//      Ein Ausbruch nach oben verwirft das Setup.
//   4. Auf den Retest des POC warten (Hoch berührt POC +/- Toleranz).
//      Schließt die Kerze wieder unter dem POC -> SELL-Signal.
//
//  Anzeige: alle Zonen von heute + den letzten X Handelstagen (Standard 2),
//  ältere Zonen werden automatisch gelöscht. Status-Tabelle für die aktuelle Zone.
//
//  Pip-Größe Gold: bei den meisten Brokern 1 Pip = 0.10 USD (100 Pips = 10 USD).
// ============================================================================
indicator("XAU M15 – Range-POC Breakout & Retest (Sell)", shorttitle="XAU POC Retest Sell", overlay=true, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─── Inputs ─────────────────────────────────────────────────────────────────
grpR = "1) Seitwärtsphase"
pipSize      = input.float(0.10, "Pip-Größe", minval=0.0001, group=grpR, tooltip="Gold (XAUUSD): meist 0.10 = 1 Pip. Falls dein Broker 0.01 als Pip zählt, hier ändern.")
minBars      = input.int(5, "Mindestanzahl Kerzen", minval=2, maxval=50, group=grpR, tooltip="Wie viele Kerzen die Seitwärtsphase mindestens dauern muss (5 oder 6).")
maxRangePips = input.float(100, "Max. Range-Höhe (Pips)", minval=1, group=grpR, tooltip="Die Phase gilt als seitwärts, solange Hoch-Tief nicht größer ist (80–100 Pips).")
maxRangeBars = input.int(150, "Max. Länge der Range (Kerzen)", minval=5, maxval=400, group=grpR)
showBox      = input.bool(true, "Range-Box anzeigen", group=grpR)

grpVP = "2) Volumenprofil"
vpRows   = input.int(40, "Anzahl Preisstufen (Auflösung)", minval=5, maxval=200, group=grpVP)
pocColor = input.color(color.orange, "POC Farbe", group=grpVP)
pocWidth = input.int(2, "POC Linienbreite", minval=1, maxval=5, group=grpVP)

grpB = "3) Breakout"
breakoutPips    = input.float(100, "Min. Breakout (Pips)", minval=1, group=grpB)
breakoutRef     = input.string("Range-Tief", "Breakout gemessen ab", options=["Range-Tief", "POC"], group=grpB)
breakoutSrc     = input.string("Schlusskurs", "Breakout bestätigt durch", options=["Schlusskurs", "Docht"], group=grpB, tooltip="Schlusskurs = Kerze muss 100 Pips unter dem Level schließen. Docht = das Tief reicht.")
maxBarsBreakout = input.int(20, "Max. Kerzen bis Breakout", minval=1, group=grpB)

grpT = "4) Retest & Signal"
retestRef        = input.string("POC", "Retest-Level", options=["POC", "Range-Tief"], group=grpT)
retestTolPips    = input.float(10, "Retest-Toleranz (Pips)", minval=0, group=grpT, tooltip="Hoch muss bis auf diese Distanz an das Level herankommen.")
requireRejection = input.bool(true, "Schluss unter Level erforderlich", group=grpT, tooltip="Signal nur, wenn die Retest-Kerze unter dem Level schließt (Ablehnung).")
invalidPips      = input.float(20, "Setup ungültig bei Schluss über Level + (Pips)", minval=0, group=grpT)
maxBarsRetest    = input.int(40, "Max. Kerzen bis Retest", minval=1, group=grpT)

grpD = "5) Anzeige"
zoneDays   = input.int(2, "Zonen der letzten X Tage zeigen", minval=0, maxval=10, group=grpD, tooltip="Zeigt alle Zonen von heute plus den letzten X Handelstagen. Ältere werden gelöscht.")
extendOld  = input.bool(false, "POC-Linien bis zur aktuellen Kerze verlängern", group=grpD, tooltip="Zieht die POCs der vorherigen Zonen als Level nach rechts.")
showPocLbl = input.bool(true, "POC-Preis beschriften", group=grpD)
showStatus = input.bool(true, "Status-Tabelle anzeigen", group=grpD)

// ─── Volumenprofil -> POC ────────────────────────────────────────────────────
// Verteilt das Volumen jeder Kerze anteilig auf die Preisstufen, die sie überdeckt.
// bars = Anzahl Range-Kerzen, beginnend mit Offset 1 (vorherige Kerze) rückwärts.
f_poc(int bars, float lo, float hi, int rows) =>
    float step = (hi - lo) / rows
    float result = (hi + lo) / 2
    if step > 0 and bars > 0
        array<float> vols = array.new<float>(rows, 0.0)
        for i = 1 to bars
            float h = high[i]
            float l = low[i]
            float rawV = nz(volume[i])
            float v = rawV > 0 ? rawV : 1.0   // kein Volumen verfügbar -> Zeit am Preis
            int r1 = math.max(0, math.min(rows - 1, math.floor((l - lo) / step)))
            int r2 = math.max(0, math.min(rows - 1, math.floor((h - lo) / step)))
            if h - l <= 0
                array.set(vols, r1, array.get(vols, r1) + v)
            else
                for r = r1 to r2
                    float rowLo = lo + r * step
                    float rowHi = rowLo + step
                    float ov = math.max(0.0, math.min(h, rowHi) - math.max(l, rowLo))
                    array.set(vols, r, array.get(vols, r) + v * ov / (h - l))
        int pocIdx = array.indexof(vols, array.max(vols))
        result := lo + (pocIdx + 0.5) * step
    result

// ─── Aufräumen alter Zonen ──────────────────────────────────────────────────
// Löscht Zeichnungen, deren Zeitstempel vor 'cutoff' liegt. 'keep' = wie viele
// der neuesten Objekte (aktive Zone) auf jeden Fall stehen bleiben.
f_cleanBoxes(array<box> objs, array<int> ts, int cutoff, int keep) =>
    while array.size(ts) > keep
        if array.get(ts, 0) >= cutoff
            break
        box.delete(array.shift(objs))
        array.shift(ts)
    true

f_cleanLines(array<line> objs, array<int> ts, int cutoff, int keep) =>
    while array.size(ts) > keep
        if array.get(ts, 0) >= cutoff
            break
        line.delete(array.shift(objs))
        array.shift(ts)
    true

f_cleanLabels(array<label> objs, array<int> ts, int cutoff) =>
    while array.size(ts) > 0
        if array.get(ts, 0) >= cutoff
            break
        label.delete(array.shift(objs))
        array.shift(ts)
    true

// ─── Zustände ───────────────────────────────────────────────────────────────
// 0 = suche Seitwärtsphase | 1 = Range aktiv | 2 = warte auf Breakout | 3 = warte auf Retest
var int   state      = 0
var int   rStart     = na
var int   rStartTime = na
var int   rEnd       = na
var float rHi        = na
var float rLo        = na
var float poc        = na
var int   stateBar   = na
var line  pocLine    = na
var box   rBox       = na

// Speicher für alle gezeichneten Zonen (für die Tages-Begrenzung)
var array<box>   zBoxes    = array.new<box>()
var array<int>   zBoxT     = array.new<int>()
var array<line>  zLines    = array.new<line>()
var array<int>   zLineT    = array.new<int>()
var array<label> zLbls     = array.new<label>()
var array<int>   zLblT     = array.new<int>()
var array<int>   dayStarts = array.new<int>()

float rangeMax = maxRangePips * pipSize
float hh = ta.highest(high, minBars)
float ll = ta.lowest(low, minBars)

bool sellSignal  = false
bool breakoutNow = false

// ─── 1) Range aktiv: verlängern oder abschließen ────────────────────────────
if state == 1
    float nHi = math.max(rHi, high)
    float nLo = math.min(rLo, low)
    int   len = bar_index - rStart + 1
    if nHi - nLo <= rangeMax and len <= maxRangeBars
        rHi := nHi
        rLo := nLo
        if showBox
            box.set_top(rBox, rHi)
            box.set_bottom(rBox, rLo)
            box.set_right(rBox, bar_index)
    else
        // Range endet mit der vorherigen Kerze -> Volumenprofil berechnen
        rEnd := bar_index - 1
        poc := f_poc(bar_index - rStart, rLo, rHi, vpRows)
        pocLine := line.new(rStart, poc, bar_index, poc, color=pocColor, width=pocWidth)
        array.push(zLines, pocLine)
        array.push(zLineT, rStartTime)
        if showPocLbl
            array.push(zLbls, label.new(rStart, poc, "POC " + str.tostring(poc, format.mintick), style=label.style_label_right, color=color.new(color.black, 100), textcolor=pocColor, size=size.small))
            array.push(zLblT, rStartTime)
        state := 2
        stateBar := bar_index

// ─── 2) Warten auf Breakout (mind. X Pips nach unten) ──────────────────────
if state == 2
    float refLvl = breakoutRef == "POC" ? poc : rLo
    float refUp  = breakoutRef == "POC" ? poc : rHi
    float dnPx   = breakoutSrc == "Schlusskurs" ? close : low
    float upPx   = breakoutSrc == "Schlusskurs" ? close : high
    line.set_x2(pocLine, bar_index)
    if dnPx <= refLvl - breakoutPips * pipSize
        state := 3
        stateBar := bar_index
        breakoutNow := true
        array.push(zLbls, label.new(bar_index, low, "BO", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.red, 40), textcolor=color.white, size=size.tiny))
        array.push(zLblT, rStartTime)
    else if upPx >= refUp + breakoutPips * pipSize
        // Ausbruch nach oben -> kein Sell-Setup
        line.set_style(pocLine, line.style_dashed)
        line.set_color(pocLine, color.gray)
        state := 0
    else if bar_index - stateBar >= maxBarsBreakout
        line.set_style(pocLine, line.style_dashed)
        line.set_color(pocLine, color.gray)
        state := 0

// ─── 3) Warten auf Retest -> SELL ───────────────────────────────────────────
if state == 3 and bar_index > stateBar
    float lvl = retestRef == "POC" ? poc : rLo
    float tol = retestTolPips * pipSize
    line.set_x2(pocLine, bar_index)
    if close > lvl + invalidPips * pipSize
        // Kurs ist zurück über das Level gelaufen -> Setup ungültig
        line.set_style(pocLine, line.style_dashed)
        line.set_color(pocLine, color.gray)
        state := 0
    else if high >= lvl - tol and (not requireRejection or close < lvl)
        sellSignal := true
        state := 0
        array.push(zLbls, label.new(bar_index, high, "SELL", yloc=yloc.abovebar, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small))
        array.push(zLblT, rStartTime)
    else if bar_index - stateBar >= maxBarsRetest
        line.set_style(pocLine, line.style_dashed)
        line.set_color(pocLine, color.gray)
        state := 0

// ─── 0) Neue Seitwärtsphase suchen ──────────────────────────────────────────
if state == 0 and bar_index >= minBars and hh - ll <= rangeMax
    int newStart = bar_index - minBars + 1
    if na(rEnd) or newStart > rEnd
        rStart := newStart
        rStartTime := time[minBars - 1]
        rHi := hh
        rLo := ll
        state := 1
        if showBox
            rBox := box.new(rStart, rHi, bar_index, rLo, border_color=color.new(pocColor, 60), bgcolor=color.new(pocColor, 90))
            array.push(zBoxes, rBox)
            array.push(zBoxT, rStartTime)

// ─── Nur heute + die letzten X Handelstage anzeigen ─────────────────────────
if timeframe.change("D")
    array.push(dayStarts, time)
    if array.size(dayStarts) > zoneDays + 1
        array.shift(dayStarts)

if array.size(dayStarts) == zoneDays + 1
    int cutoff = array.get(dayStarts, 0)
    f_cleanBoxes(zBoxes, zBoxT, cutoff, state == 1 ? 1 : 0)
    f_cleanLines(zLines, zLineT, cutoff, state >= 2 ? 1 : 0)
    f_cleanLabels(zLbls, zLblT, cutoff)

// Vorherige POCs optional als Level bis zur aktuellen Kerze ziehen
if barstate.islast and extendOld and array.size(zLines) > 0
    for ln in zLines
        line.set_x2(ln, bar_index)

// ─── Alerts ─────────────────────────────────────────────────────────────────
alertcondition(sellSignal, "XAU POC Retest SELL", "Gold M15: Retest des POC nach Breakout – SELL-Signal")
alertcondition(breakoutNow, "XAU Range Breakout", "Gold M15: Breakout nach unten aus der Seitwärtsphase – warte auf Retest")

if sellSignal
    alert("SELL XAUUSD @ " + str.tostring(close, format.mintick) + " | POC " + str.tostring(poc, format.mintick), alert.freq_once_per_bar_close)

// ─── Status der aktuellen Zone ──────────────────────────────────────────────
var table info = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 30), border_width=1)
if barstate.islast
    string st = state == 0 ? "Suche Seitwärtsphase" : state == 1 ? "Seitwärtsphase läuft" : state == 2 ? "Warte auf Breakout ↓" : "Warte auf Retest → SELL"
    if showStatus
        table.cell(info, 0, 0, "Status", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, st, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 1, "Range", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 1, state >= 1 ? str.tostring(rLo, format.mintick) + " – " + str.tostring(rHi, format.mintick) : "–", text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "Aktueller POC", text_color=color.white, text_size=size.small)
        table.cell(info, 1, 2, state >= 2 ? str.tostring(poc, format.mintick) : "–", text_color=pocColor, text_size=size.small)
    if timeframe.period != "15"
        table.cell(info, 0, 3, "Achtung", text_color=color.white, bgcolor=color.red, text_size=size.small)
        table.cell(info, 1, 3, "Für den 15-Min-Chart gebaut", text_color=color.white, bgcolor=color.red, text_size=size.small)
